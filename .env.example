# Clave de la API de DeepSeek (obligatoria)
DEEPSEEK_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Puerto del servidor (opcional, por defecto 3000)
PORT=3000
